# Copy to .env.local. Names and placeholders only - never commit real secrets.

# Required in production. Used to encrypt provider API keys stored by the admin screen (AES-256-GCM).
# Generate with: openssl rand -base64 32
APP_SECRET=replace-with-a-long-random-string

# Where the SQLite database and uploaded resume files live (object-storage stand-in).
DATABASE_PATH=./data/app.db
UPLOAD_DIR=./data/uploads

# Public origin used for the CSRF origin check. Defaults to the request host in development.
APP_ORIGIN=http://localhost:3000

# Optional provider credentials. Leave blank to run on the built-in mock provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional embedding provider: "local" (default, deterministic hashing) or "openai".
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small

# Demo banner and sample data. Set to "false" only when real providers are configured.
DEMO_MODE=true
